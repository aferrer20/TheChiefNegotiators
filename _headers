/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*.css
  Cache-Control: public, max-age=604800, must-revalidate
/assets/*.js
  Cache-Control: public, max-age=604800, must-revalidate
/assets/*.png
  Cache-Control: public, max-age=2592000, must-revalidate
/assets/*.webp
  Cache-Control: public, max-age=2592000, must-revalidate
/assets/*.svg
  Cache-Control: public, max-age=2592000, must-revalidate
